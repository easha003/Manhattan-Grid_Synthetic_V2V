.DS_Store
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.egg-info/
*.py[cod]
.venv/
build/
dist/

# Published papers are not ours to redistribute. The dossier notes in
# research/literature/*.md are our own analysis and are tracked.
research/literature/pdfs/

# Calibration artifacts and figures are tracked. They are *inputs*, not
# outputs: the headline profile names a pattern artifact by path, so a fresh
# clone cannot evaluate a single packet without one, and the report embeds the
# figures it cites. Together they are about a megabyte, which is a fair price
# for a repository that runs after `git clone` rather than after a build step.
#
# Evaluation results and training checkpoints stay out: those are outputs, they
# grow without bound across conditions, and every number they carry is already
# quoted in the report and its commit history.
artifacts/checkpoints/*
artifacts/evaluations/*

# Except this one. headlamp-ece-r112-v1 is the superseded test-point pattern:
# it credited zone IV 1,875 cd against the regulation's 2,500, carried a
# vertical axis with 75R's *horizontal* coordinate on it, and applied the zone
# IV floor far outside zone IV's box. It is kept on disk so the earlier numbers
# can be reproduced, and kept out of the repository so nobody points a profile
# at it by accident. scripts/build_headlamp_pattern.py regenerates the
# replacement and verifies its compliance before writing.
artifacts/calibration/vlc/headlamp-ece-r112-v1/

# Generated mobility traces. Roughly 280 MB per trace and 21 traces to a
# campaign, so versioning them would put gigabytes of parquet in history for
# artifacts that are reproducible from a config hash and a code commit.
# artifacts/archive/ is deliberately *not* ignored: it keeps manifests, routes
# and pairs for superseded campaigns with the vehicle stream stripped out, a
# few megabytes that record what was run.
#
# This rule also fixes provenance. The writer's output directory used to be
# untracked and unignored, so `git status --porcelain` was non-empty while a
# campaign was being written and every manifest was stamped `-dirty` by the
# traces themselves. An artifact that dirties the tree it is stamping can never
# record a clean commit.
artifacts/traces/*
!artifacts/traces/.gitkeep
artifacts/traces-*/
artifacts/traces/*

!artifacts/checkpoints/.gitkeep
!artifacts/evaluations/.gitkeep
!artifacts/traces/.gitkeep

# Superseded campaigns are kept on disk for bookkeeping.  Track only the small
# provenance records; the parquet bulk stays local like any other trace data.
artifacts/archive/**
!artifacts/archive/*/
!artifacts/archive/*/ARCHIVE_NOTE.md
!artifacts/archive/*/campaign_manifest.json

# Claude Code tool settings (permission grants, not project configuration).
.claude/

# LaTeX build products; the .tex and the built PDF are tracked.
docs/report/*.aux
docs/report/*.log
docs/report/*.out
docs/report/*.toc
